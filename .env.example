# Copy this file to ".env" and fill in your real keys.
# Never commit your real .env file.

# --- OpenRouter (Harper's conversation brain) ---
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: pick any model from https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Accounts (just you two) ---
# Set a password for each login. If left blank, insecure defaults are used
# (heather/unicorns, chuck/puppies) and the app warns you on screen.
HEATHER_PASSWORD=
CHUCK_PASSWORD=
# How long Harper's cool-down lasts, in minutes.
COOLDOWN_MINUTES=60
# Path to Harper's portrait image (a placeholder shows until this file exists).
HARPER_AVATAR=assets/harper.png

# --- Fish Audio (Harper's voice) ---
# Create a key at https://fish.audio  (API Keys)
FISH_AUDIO_API_KEY=
# A voice reference_id copied from the Fish Audio discovery page.
FISH_AUDIO_REFERENCE_ID=
# Model: s1 or s2-pro
FISH_AUDIO_MODEL=s2-pro
